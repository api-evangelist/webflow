          "name": "Webflow Get Workspace Audit Logs",
          "request": {
            "name": "Webflow Get Workspace Audit Logs",
            "description": {
              "content": "Get audit logs for a workspace.\n\n<Warning title=\"Enterprise & workspace API token only\">This endpoint requires an Enterprise workspace and a workspace token with the `workspace_activity:read` scope. Create a workspace token from your workspace dashboard integrations page to use this endpoint.</Warning>\n\nRequired scope | `workspace_activity:read`\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "workspaces",
                ":workspace_id_or_slug",
                "audit_logs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of records to be returned (max limit: 100)"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Offset used for pagination if the results have more than limit records"
                },
                {
                  "disabled": false,
                  "key": "sortOrder",
                  "value": "<string>",
                  "description": "Sorts the results by asc or desc"
                },
                {
                  "disabled": false,
                  "key": "eventType",
                  "value": "<string>",
                  "description": "The event type to filter by"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<dateTime>",
                  "description": "The start date to filter by"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<dateTime>",
                  "description": "The end date to filter by"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "",
                  "key": "workspace_id_or_slug",
                  "description": "(Required) Unique identifier or slug for a Workspace"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "authorized_user:read assets:read assets:write cms:read cms:write comments:read comments:write custom_code:read custom_code:write ecommerce:read ecommerce:write forms:read forms:write pages:read pages:write components:read components:write sites:read sites:write users:read site_activity:read users:write workspace:read workspace:write site_config:read site_config:write"
